// Removing built-in keybindings.
pub fn config() {
    // Remove chords from every scope.
    keybind::remove_everywhere("s");
    keybind::remove_everywhere("space");

    // `h` and `esc` share one source (close the file view). Unbinding `esc`
    // prunes only that chord and leaves `h` working.
    keybind::remove_everywhere("esc");

    // Re-add only what you want.
    keybind::in_view("file", || {
        keybind::bind("space", || view::file::staging::toggle());
        keybind::bind("x", || view::file::staging::split());
    });

    // Wipe everything (core + custom) and start clean:
    // keybind::remove_all();
    // keybind::bind("j", || view::file::cursor::down(1));

    // Restore the built-in defaults after clearing or overriding:
    // keybind::restore_defaults();
}
