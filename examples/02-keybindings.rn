// Rebinding keys and scoping binds to a view.
pub fn config() {
    // Modifiers: ctrl (control), alt, shift. Combine them with '-'.
    keybind::bind("ctrl-shift-j", || view::file::cursor::down(10));
    keybind::bind("ctrl-shift-k", || view::file::cursor::up(10));

    // Global actions.
    keybind::bind("ctrl-s", || view::file::staging::stage_all());
    keybind::bind("ctrl-z", || global::undo());

    // Binds registered inside keybind::in_view only apply to that view.
    keybind::in_view("file", || {
        keybind::bind("ctrl-d", || view::file::cursor::half_page_down());
        keybind::bind("ctrl-u", || view::file::cursor::half_page_up());
        keybind::bind("Y", || global::copy(view::file::path()));
    });

    keybind::in_view("tree", || {
        keybind::bind("ctrl-d", || view::tree::cursor::down(20));
        keybind::bind("ctrl-u", || view::tree::cursor::up(20));
        keybind::bind("l", || view::tree::open_selected());
    });
}
