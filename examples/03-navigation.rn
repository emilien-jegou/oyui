// Moving around files and the tree.
pub fn config() {
    keybind::in_view("file", || {
        // Hunk-to-hunk.
        keybind::bind("n", || view::file::nav::next_hunk());
        keybind::bind("N", || view::file::nav::prev_hunk());

        // Collapse/expand unchanged context.
        keybind::bind("z", || view::file::fold::toggle());

        // Jump to the extremes.
        keybind::bind("g", || view::file::cursor::top());
        keybind::bind("G", || view::file::cursor::bottom());

        // Horizontal scroll.
        keybind::bind("ctrl-h", || view::file::scroll::left(4));
        keybind::bind("ctrl-l", || view::file::scroll::right(4));
    });

    keybind::in_view("tree", || {
        // Directories.
        keybind::bind("l", || view::tree::directory::expand());
        keybind::bind("h", || view::tree::directory::collapse());
        keybind::bind("L", || view::tree::directory::expand_all());
        keybind::bind("H", || view::tree::directory::collapse_all());

        // Open the selected row (file or directory).
        keybind::bind("enter", || view::tree::open_selected());
    });

    // Switch panes from anywhere.
    keybind::bind("ctrl-1", || session::switch("tree"));
    keybind::bind("ctrl-2", || session::switch("file"));
}
