// Staging hunks/lines, bulk operations and undo.
pub fn config() {
    keybind::in_view("file", || {
        keybind::bind("space", || view::file::staging::toggle());
        keybind::bind("t", || view::file::staging::toggle_line());
        keybind::bind("s", || view::file::staging::split());
        keybind::bind("J", || view::file::staging::join());
        keybind::bind("i", || view::file::staging::invert());
    });

    keybind::in_view("tree", || {
        keybind::bind("space", || view::tree::staging::toggle_selected());
        keybind::bind("i", || view::tree::staging::invert());
    });

    keybind::bind("u", || global::undo());
    keybind::bind("ctrl-r", || global::redo());

    // Palette commands for bulk work.
    commands::register("stage-tests", |args| view::tree::staging::set_matching("**/*test*", true));
    commands::register("unstage-all", |args| view::tree::staging::unstage_all());
    commands::register("stage-src", |args| {
        view::tree::staging::set_matching("src/**", true);
        global::notify("staged src/**");
    });
}
