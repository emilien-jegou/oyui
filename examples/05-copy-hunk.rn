// Copy a hunk or the current path to the system clipboard (OSC 52).
pub fn config() {
    // Copy the hunk under the cursor. `hunk_index` is `Option`.
    command("copy_hunk", |args| {
        if let Some(_hunk) = view::file::cursor::hunk_index() {
            global::copy(view::file::inspect::hunk_text());
            global::notify("hunk copied");
        } else {
            global::error("no hunk under cursor");
        }
    });

    // Copy the unified diff of the open file.
    command("copy_diff", |args| {
        let text = view::file::inspect::diff_text();
        if text == "" {
            global::warn("no diff to copy");
        } else {
            global::copy(text);
            global::notify("diff copied");
        }
    });

    // Copy the open file path, or the tree selection.
    command("copy_path", |args| {
        let path = view::file::path();
        if path == "" {
            global::copy(view::tree::selected_path());
        } else {
            global::copy(path);
        }
        global::notify("path copied");
    });

    keybind("Y", || global::command("copy_hunk"));
}
