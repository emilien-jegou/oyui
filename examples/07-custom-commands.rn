// Register custom palette commands (`:name`).
pub fn config() {
    // Commands receive the raw argument string after the command name.
    commands::register("invert-selection", |args| view::file::staging::invert());

    commands::register("stage-md", |args| {
        view::tree::staging::set_matching("**/*.md", true);
        global::notify("staged markdown");
    });

    commands::register("echo", |args| {
        if args == "" {
            global::warn("echo: missing argument");
        } else {
            global::notify(args);
        }
    });

    // `commands::list()` lists every registered script command.
    commands::register("list-commands", |args| {
        let names = commands::list();
        if names.is_empty() {
            global::warn("no script commands");
        } else {
            global::copy(names.join("\n"));
            global::notify("command names copied");
        }
    });

    // Run a builtin palette command from a keybind.
    keybind::bind("ctrl-g", || commands::run("invert"));
}
